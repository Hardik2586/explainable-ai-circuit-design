* Phase 4 common-source candidate
.include "2N7000.onsemi.lib"
VDD vdd 0 DC 12
VIN in 0 DC 0 AC 1
RGU vdd gate 111857.364719
RGL gate 0 65868.6456595
RD vdd drain 2316.41588985
RS source 0 954.240777914
CIN in gate 4.83146903043e-06
XM1 drain gate source 2N7000
.control
set noaskquit
op
echo PH4_DC_BEGIN
print v(vdd)
print v(gate)
print v(drain)
print v(source)
echo PH4_DC_END
ac lin 1 1000 1000
let ph4gain = vdb(drain) - vdb(in)
echo PH4_GAIN_BEGIN
print ph4gain
echo PH4_GAIN_END
quit
.endc
.end
