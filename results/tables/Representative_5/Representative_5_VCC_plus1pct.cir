set noaskquit
op
print v(base)
print v(emit)
print v(coll)
print @q1[ib]
print @q1[ic]
print @q1[ie]
ac dec 20 10 1000000000
wrdata Representative_5_VCC_plus1pct_gain.txt vdb(out)
